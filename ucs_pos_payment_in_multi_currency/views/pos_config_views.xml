<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_multi_currency" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.multi.currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting id="enable_multi_currency_setting" string="Multi Currency" help="Accept payments in multiple currencies">
                    <field name="pos_enable_multi_currency"/>
                    <div class="content-group" invisible="not pos_enable_multi_currency">
                        <div class="mt16">
                            <label for="pos_multi_currency_ids" string="Accepted Currencies" class="o_light_label"/>
                            <field name="pos_multi_currency_ids" widget="many2many_tags" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
